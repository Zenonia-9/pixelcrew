{
  "name": "pixelcrew",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n service,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && node scripts/build-release.mjs",
    "start": "node .build/server/controller.js --open",
    "assets": "node scripts/draw-assets.mjs",
    "test": "tsx --import ./scripts/test-env.mjs --test tests/*.test.ts",
    "service": "node .build/server/controller.js",
    "package:windows": "node scripts/package-release.mjs",
    "test:release": "tsx scripts/verify-release.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "fastify": "^5.6.0",
    "smol-toml": "^1.9.1",
    "ws": "^8.22.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.468.0",
    "pixi.js": "^8.14.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
