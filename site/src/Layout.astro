---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/600.css';
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/Zenonia-9/pixelcrew';
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
<meta name="description" content="Run a crew of Codex agents from one Windows workspace." />
<link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
<title>{title} · PixelCrew</title></head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header><nav aria-label="Main navigation">
<a class="brand" href={base}>PixelCrew</a>
<a href={base + 'download/'}>Download</a><a href={base + 'guide/'}>Guide</a>
<a href={base + 'changelog/'}>Changelog</a><a class="nav-cta" href="https://apps.microsoft.com/detail/9MSPKZ7CZ3W1">Get PixelCrew ↗</a></nav></header>
<main id="main"><slot /></main>
<footer><a href="https://apps.microsoft.com/detail/9MSPKZ7CZ3W1">Get PixelCrew</a><a href={base + 'privacy/'}>Privacy policy</a><a href={repo + '/blob/v1.0-win64/LICENSE.txt'}>License</a><a href={base + 'changelog/'}>Changelog</a><a href={repo + '/issues'}>GitHub Issues</a></footer>
</body></html>
<style is:global>
:root{color-scheme:dark;--canvas:#010102;--surface:#0f1011;--ink:#f7f8f8;--muted:#b5bac3;--line:#34343a;--gold:#efc47b}
*{box-sizing:border-box}
body{margin:0;background:linear-gradient(rgba(1,1,2,.90),rgba(1,1,2,.96)),url('/pixelcrew/PixelCrew-Banner-1920x1080.png') center top / cover fixed no-repeat,var(--canvas);color:var(--ink);font:16px/1.6 'DM Sans',sans-serif}
a{color:var(--gold)}
a:focus-visible{outline:2px solid var(--gold);outline-offset:5px}
header{border-bottom:1px solid #23252a;background:#010102}
nav,main,footer{width:min(1100px,calc(100% - 40px));margin:auto}
nav,footer,.actions{display:flex;align-items:center;gap:1rem;flex-wrap:wrap}
nav,footer{padding:1rem 0} nav{min-height:68px;gap:1.5rem} nav a:not(.brand){font-size:14px;color:#d0d6e0} nav a:hover{color:#fff} nav .nav-cta{border:1px solid #34343a;border-radius:8px;padding:8px 12px}nav a{text-decoration:none;color:var(--ink)}.brand{margin-right:auto;font-weight:600;color:var(--gold)}
main{padding:clamp(2.5rem,7vw,6rem) 0}footer{border-top:1px solid var(--line);font-size:.875rem}
h1,h2{line-height:1.12;letter-spacing:-.035em;margin:0 0 1rem;overflow-wrap:break-word}h1{font-size:clamp(2rem,6vw,4.5rem);max-width:20ch}h2{font-size:clamp(1.35rem,3vw,2.5rem)}
p{color:var(--muted);max-width:68ch}section+section{margin-top:clamp(3rem,8vw,6rem)}
.button{display:inline-flex;padding:.55rem .95rem;border:1px solid var(--line);border-radius:8px;text-decoration:none;color:var(--ink);background:var(--surface)}
.button{min-height:42px;align-items:center;justify-content:center}.button:hover{border-color:#777}.primary{background:var(--gold);color:var(--canvas);font-weight:600}
figure{margin:1.75rem 0 0}img{display:block;max-width:100%;height:auto;border:1px solid var(--line);border-radius:.65rem}figcaption{margin-top:.5rem;color:var(--muted)}
.prose{max-width:76ch}.prose p,.prose li{line-height:1.75;overflow-wrap:anywhere}.prose code{overflow-wrap:anywhere}.prose h1{font-size:clamp(2rem,5vw,3.5rem);max-width:none}.prose h2{margin-top:2.25rem}.prose table{width:100%;border-collapse:collapse}.prose th,.prose td{text-align:left;padding:.5rem;border-bottom:1px solid var(--line);overflow-wrap:anywhere}
.skip{position:absolute;left:1rem;top:1rem;background:var(--surface);padding:.5rem;transform:translateY(-200%)}.skip:focus{transform:none}
@media(max-width:600px){nav{gap:.5rem 1rem}nav .brand{flex-basis:100%;margin-right:0}nav .nav-cta{margin-left:auto}.actions{align-items:stretch;flex-direction:column}.actions .button{width:100%}.prose th,.prose td{padding:.4rem .25rem}.prose table{font-size:.875rem}}
</style>
