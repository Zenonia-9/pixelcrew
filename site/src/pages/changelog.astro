---
import Layout from '../Layout.astro';
import { publishedReleases as releases } from '../releases';
---
<Layout title="Changelog">
  <div class="reading-panel">
  <h1>Changelog</h1>
  <p class="intro">Updates and improvements to your PixelCrew workspace.</p>
  {releases.map(release => (
    <section class="release-entry">
      <h2>PixelCrew v{release.version}</h2>
      {['1.0.0', '1.0.1', '1.0.2'].includes(release.version) && <span class="legacy">Legacy standalone EXE release</span>}
      {release.date && <time datetime={release.date}>{release.date}</time>}
      <p>{release.summary}</p>
      <div class="actions">
        {release.notes && <a href={release.notes}>Release notes ↗</a>}
      </div>
    </section>
  ))}
  </div>
</Layout>
<style>
.release-entry { margin-top: 0; padding: 32px 0; border-top: 1px solid var(--line); }
.release-entry h2 { font-size: 24px; letter-spacing: -.03em; }
.intro { margin: 16px 0 48px; font-size: 18px; }
.release-entry time { color: var(--muted); display: block; margin-top: 8px; }
.legacy { display: inline-block; color: var(--muted); background: #18191a; border: 1px solid #34343a; border-radius: 999px; padding: 3px 10px; font-size: 12px; }
</style>
