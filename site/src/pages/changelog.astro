---
import Layout from '../Layout.astro';
import { publishedReleases as releases } from '../releases';
---
<Layout title="Changelog">
  <h1>Changelog</h1>
  {releases.map(release => (
    <section class="release-entry">
      <h2>PixelCrew v{release.version}</h2>
      {release.date && <time datetime={release.date}>{release.date}</time>}
      <p>{release.summary}</p>
      <div class="actions">
        <a href={release.notes}>v{release.version} release notes</a>
      </div>
    </section>
  ))}
</Layout>
<style>
.release-entry { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
.release-entry time { color: var(--muted); }
</style>
