---
import Layout from '../Layout.astro';
import { latestRelease as release, previousReleases } from '../releases';
---
<Layout title="Download for Windows">
<h1>{release ? 'Download for Windows x64' : 'Windows release coming soon'}</h1>
<p>PixelCrew {release?.version} · Windows x64 · {release?.signing} installer{release?.date ? ' · ' + release.date : ''}</p>
<p>Install Codex separately and sign in. Setup may prompt you to install Microsoft Edge WebView2.</p>
<div class="actions">
{release && <><a class="button primary" href={release.installer}>Download v{release.version} for Windows x64</a>{release.checksum && <a class="button" href={release.checksum}>SHA-256 checksum</a>}<a class="button" href={release.notes}>Release notes</a></>}
<a class="button" href={import.meta.env.BASE_URL + 'guide/'}>Read the installation guide</a>
</div>
{previousReleases.length > 0 && <section class="previous-releases">
<h2>Previous versions</h2>
<ul>
{previousReleases.map(version => <li>
  <strong>PixelCrew {version.version}</strong> · {version.signing} installer
  <div class="actions"><a href={version.installer}>Download v{version.version}</a><a href={version.notes}>v{version.version} release notes</a>{version.checksum && <a href={version.checksum}>SHA-256 checksum</a>}</div>
</li>)}
</ul>
</section>}
</Layout>
<style>
.previous-releases { margin-top: 3rem; }
.previous-releases ul { padding-left: 1.25rem; }
.previous-releases li + li { margin-top: 1rem; }
</style>
