---
import Layout from '../Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="A workspace for Codex agents">
<section class="hero">
<h1>Run a crew of Codex agents from one Windows workspace.</h1>
<p>Assign work to specialists, follow their handoffs, and make decisions as your crew works.</p>
<div class="actions"><a class="button primary" href="https://apps.microsoft.com/detail/9MSPKZ7CZ3W1">Get it from Microsoft Store</a><a class="button" href={base + 'guide/'}>Read the installation guide</a></div>
<p>Free · Windows x64 · Automatic updates</p>
</section>
<section class="whats-new"><h2>New in PixelCrew 1.2.2</h2>
<p>Get started with the bundled Codex runtime, keep projects and chats in a durable local profile, and move supported data to another device with Device Transfer.</p>
<a href={base + 'changelog/'}>See what changed →</a>
</section>
<section class="tour"><h2>Explore PixelCrew</h2>
<div class="tour-grid">
<article><h3>Office</h3>
<figure><a href={base + 'office.png'}><img src={base + 'office.png'} alt="PixelCrew office showing Atlas, Pip, Bolt, Mira, and Nova at their desks" /></a><figcaption>See which specialists are working and follow their progress.</figcaption></figure>
</article>
<article><h3>Team tasks</h3>
<figure><a href={base + 'team-task.png'}><img src={base + 'team-task.png'} alt="PixelCrew Team conversation showing specialist assignments alongside the office" loading="lazy" /></a><figcaption>Follow assignments and handoffs, and review approval requests.</figcaption></figure>
</article>
<article><h3>In-app Browser</h3>
<figure><a href={base + 'browser.png'}><img src={base + 'browser.png'} alt="PixelCrew Team conversation beside the in-app Browser" loading="lazy" /></a><figcaption>Open documentation and work with sites from the Browser panel.</figcaption></figure>
</article>
</div>
<div class="actions tour-action"><a class="button" href={base + 'download/'}>Go to Download</a></div>
</section></Layout>

<style>
.hero { padding-top: clamp(12px, 3vw, 40px); }
.hero h1 { max-width: 850px; font-size: clamp(2rem, 6.8vw, 4.75rem); font-weight: 600; line-height: 1.08; letter-spacing: -.045em; }
.hero > p:first-of-type { max-width: 580px; font-size: clamp(1rem, 2vw, 1.1875rem); line-height: 1.5; }
.hero .actions { margin-top: 28px; }
.tour-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.tour-grid article { padding: clamp(12px, 2vw, 22px); background: var(--surface); border: 1px solid var(--line); border-radius: 16px; }
.tour-grid h3 { margin: 0; font-size: 1.125rem; }
.tour-grid figure { margin-top: 12px; }
.tour-action { margin-top: 24px; }
@media (max-width: 800px) { .tour-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
