---
import Layout from '../Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="A workspace for Codex agents">
<section class="hero">
<h1>Run a crew of Codex agents from one Windows workspace.</h1>
<p>Assign work to specialists, follow their handoffs, and make decisions as your crew works.</p>
<div class="actions"><a class="button primary" href="https://apps.microsoft.com/detail/9MSPKZ7CZ3W1">Get it from Microsoft Store</a><a class="button" href={base + 'guide/'}>Read the installation guide</a></div>
<p>Free · Windows x64 · Automatic updates</p>
</section>
<section class="feature"><div><h2>Meet your crew</h2><p>Bring your specialists together in a workspace built for collaboration.</p></div>
<figure><a href={base + 'office.png'}><img src={base + 'office.png'} alt="PixelCrew office showing Atlas, Pip, Bolt, Mira, and Nova at their desks" /></a></figure>
</section>
<section class="feature"><h2>Follow a Team task</h2><p>Choose a project and send a task in Team mode. Follow specialist assignments and results in the conversation, and review approval requests as they arrive.</p>
<figure><a href={base + 'team-task.png'}><img src={base + 'team-task.png'} alt="PixelCrew Team conversation showing specialist assignments alongside the office" loading="lazy" /></a></figure>
</section></Layout>

<style>
.hero { padding-top: clamp(12px, 3vw, 40px); }
.hero h1 { max-width: 850px; font-size: clamp(2rem, 6.8vw, 4.75rem); font-weight: 600; line-height: 1.08; letter-spacing: -.045em; }
.hero > p:first-of-type { max-width: 580px; font-size: clamp(1rem, 2vw, 1.1875rem); line-height: 1.5; }
.hero .actions { margin-top: 28px; }
.feature figure { padding: clamp(8px, 1.5vw, 16px); background: #0f1011; border: 1px solid #23252a; border-radius: 16px; }
.feature { max-width: 100%; }
.feature h2 { font-weight: 600; }
</style>
