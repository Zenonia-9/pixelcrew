---
import Layout from '../Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="A workspace for Codex agents">
<section>
<h1>Run a crew of Codex agents from one Windows workspace.</h1>
<p>Assign work to specialists, follow their handoffs, and make decisions as your crew works.</p>
<div class="actions"><a class="button primary" href="https://apps.microsoft.com/detail/9MSPKZ7CZ3W1">Get it from Microsoft Store</a><a class="button" href={base + 'guide/'}>Read the installation guide</a></div>
<p>Free · Windows x64 · Automatic updates</p>
<figure><img src={base + 'PixelCrew-Banner-1920x1080.png'} width="1920" height="1080" alt="PixelCrew pixel art banner" /></figure>
</section>
<section><h2>Meet your crew</h2>
<figure><a href={base + 'office.png'}><img src={base + 'office.png'} alt="PixelCrew office showing Atlas, Pip, Bolt, Mira, and Nova at their desks" /></a></figure>
</section>
<section><h2>Follow a Team task</h2><p>Choose a project and send a task in Team mode. Follow specialist assignments and results in the conversation, and review approval requests as they arrive.</p>
<figure><a href={base + 'team-task.png'}><img src={base + 'team-task.png'} alt="PixelCrew Team conversation showing specialist assignments alongside the office" loading="lazy" /></a></figure>
</section></Layout>
